{
  "name": "juju",
  "version": "0.0.28",
  "description": "Self-hosted family planner - calendar, tasks, shopping, meal planning, budget and more. Private, open-source, no subscription.",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --import dotenv/config server/index.js",
    "dev": "node --import dotenv/config --watch server/index.js",
    "setup": "node --import dotenv/config setup.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.14",
    "lunar-javascript": "^1.7.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "openid-client": "^6.8.8",
    "sm-crypto": "^0.5.7",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "googleapis": "^173.0.0",
    "tsdav": "^2.3.1"
  },
  "license": "MIT",
  "devDependencies": {
    "puppeteer": "^25.4.0",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "bcrypt@6.0.0": true,
    "puppeteer@25.4.0": true
  }
}

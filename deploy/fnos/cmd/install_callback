#!/bin/bash

### 安装后执行：预建数据目录并生成 Juju 应用密钥。
### 幂等：密钥仅在首次生成，重装/升级不覆盖（否则数据库将无法解密）。
###
### 数据目录直接用 TRIM_PKGVAR（/var/apps/juju/var → /vol{n}/@appdata/juju），
### compose 中同样以 ${TRIM_PKGVAR}/data、${TRIM_PKGVAR}/backups 挂载。
### 不使用 .env 文件：飞牛运行 compose 的工作目录未必是 compose 所在目录，
### .env 不会被读取（实测 JUJU_* 变量告警），端口与路径一律靠平台注入的环境变量。

set -u

APPDEST="${TRIM_APPDEST}"
ETCDIR="${TRIM_PKGETC}"
DATADIR="${TRIM_PKGVAR}/data"
BACKUPDIR="${TRIM_PKGVAR}/backups"

# ---- 预建数据目录（以包用户身份创建，保证属主正确；docker 也会自动补建）----
mkdir -p "$DATADIR" "$BACKUPDIR" 2>/dev/null || true

# ---- 应用密钥（仅首次生成）----
if [ ! -f "$ETCDIR/juju.env" ]; then
  mkdir -p "$ETCDIR"
  cat > "$ETCDIR/juju.env" <<EOF
NODE_ENV=production
PORT=3000
DB_PATH=/data/yuvomi.db
BACKUP_DIR=/backups
DB_ENCRYPTION_KEY=$(openssl rand -hex 32)
JUJU_SM4_KEY=$(openssl rand -hex 16)
SESSION_SECRET=$(openssl rand -hex 32)
SESSION_SECURE=false
TRUST_PROXY=loopback
EOF
  chmod 600 "$ETCDIR/juju.env"
fi

exit 0

#!/bin/bash

### 卸载后执行：默认保留数据；仅当用户在卸载向导选择"删除数据"时才清理。
### 清理范围：TRIM_PKGVAR 下的 data/backups 子目录与 etc 中的密钥。
### 绝不删除 TRIM_PKGVAR 本身。幂等：重复执行安全。

set -u

if [ "${wizard_data_choice:-keep}" = "delete" ]; then
  DATADIR="${TRIM_PKGVAR}/data"
  BACKUPDIR="${TRIM_PKGVAR}/backups"
  ETCDIR="${TRIM_PKGETC}"

  # 目录存在性校验后清理
  [ -d "$DATADIR" ] && rm -rf "$DATADIR"
  [ -d "$BACKUPDIR" ] && rm -rf "$BACKUPDIR"

  # 密钥文件
  rm -f "$ETCDIR/juju.env"
fi

exit 0

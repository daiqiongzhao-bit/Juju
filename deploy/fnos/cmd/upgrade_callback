#!/bin/bash

### 升级后执行：确保数据目录与密钥存在（升级可能替换 target 目录，但
### TRIM_PKGVAR/TRIM_PKGETC 跨版本稳定，密钥与数据天然保留）。
### 幂等：密钥仅在缺失时生成。

set -u

ETCDIR="${TRIM_PKGETC}"
DATADIR="${TRIM_PKGVAR}/data"
BACKUPDIR="${TRIM_PKGVAR}/backups"

mkdir -p "$DATADIR" "$BACKUPDIR" 2>/dev/null || true

if [ ! -f "$ETCDIR/juju.env" ]; then
  mkdir -p "$ETCDIR"
  cat > "$ETCDIR/juju.env" <<EOF
NODE_ENV=production
PORT=3000
DB_PATH=/data/yuvomi.db
BACKUP_DIR=/backups
DB_ENCRYPTION_KEY=$(openssl rand -hex 32)
JUJU_SM4_KEY=$(openssl rand -hex 16)
SESSION_SECRET=$(openssl rand -hex 32)
SESSION_SECURE=false
TRUST_PROXY=loopback
EOF
  chmod 600 "$ETCDIR/juju.env"
fi

exit 0
